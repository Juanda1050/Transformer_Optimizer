{
  "name": "Transformer Optimizer",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/cmake:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  },
  "postCreateCommand": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build"
}
